{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "streams": {
    "main": {
      "credentials": ["crates-io"],
      "packages": [
        "pkg:cargo/fujo-error",
        "pkg:cargo/fujo-core",
        "pkg:cargo/fujo-output",
        "pkg:cargo/fujo-complete",
        "pkg:cargo/fujo"
      ],
      "versionScope": "one-for-stream",
      "mustPublish": [
        "pkg:cargo/fujo-error",
        "pkg:cargo/fujo-core",
        "pkg:cargo/fujo-output",
        "pkg:cargo/fujo-complete",
        "pkg:cargo/fujo"
      ],
      "prepare": {
        "version": "manual",
        "strategy": "managed",
        "versionLands": "via-version-pr",
        "versionPrMerge": "manual",
        "workflow": {
          "file": "prepare-release.yml",
          "mode": "dispatch",
          "ref": "master"
        }
      },
      "promote": {
        "publishWhen": "version-pr-merged",
        "workflow": {
          "file": "publish.yml",
          "mode": "dispatch",
          "ref": "master",
          "publications": [
            "pkg:cargo/fujo-error",
            "pkg:cargo/fujo-core",
            "pkg:cargo/fujo-output",
            "pkg:cargo/fujo-complete",
            "pkg:cargo/fujo",
            "github-release:kjanat/fujo"
          ],
          "refs": {
            "phase": "version",
            "prefix": "v",
            "signed": true
          }
        }
      }
    }
  },
  "managers": ["cargo", "workflow"]
}
